{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:attendance-demo": "tsx src/scripts/seed-attendance-demo.ts",
    "docs:generate": "tsx src/scripts/generate-documents.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "googleapis": "^166.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "node-cron": "^4.2.1",
    "openai": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.6",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
